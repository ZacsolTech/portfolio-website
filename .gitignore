# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/scripts/audit-out/
/audit-/
audit-*.png

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code — share project settings, keep personal overrides local
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# payload
/public/media/*
!/public/media/.gitkeep
src/payload-types.ts
