# Copy to .env.local (or .env) and fill in values.
# Never commit real secrets. Server-only keys must not use NEXT_PUBLIC_.

# Google AI Studio — Gemini (server-only)
GEMINI_API_KEY=
# Optional model overrides. Defaults are pinned to gemini-3.1-flash-lite.
# Do NOT use the "*-latest" aliases: they float to the newest release, and new
# models ship with a free-tier quota of 0-20 requests/day, so the consultant
# silently falls back to the rules engine. Verify a model has quota first:
#   GET https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# GEMINI_BLUEPRINT_MODEL=gemini-3.1-flash-lite
# GEMINI_CHAT_TIMEOUT_MS=20000
# GEMINI_BLUEPRINT_TIMEOUT_MS=35000

# Cost estimator: blended delivery rate per person-week, in USD.
# Every figure the estimator quotes scales directly off this, so change it
# deliberately. Default 4000.
# ESTIMATOR_WEEKLY_RATE_USD=4000

# Payload CMS
PAYLOAD_SECRET=

# Neon Postgres
# Prefer sslmode=verify-full (or omit sslmode — we normalize require → verify-full in code)
DATABASE_URL=

# Upstash Redis (consultant sessions + rate limits — optional; in-memory fallback
# in dev. Required in production: serverless instances don't share memory.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend transactional email. Every notification channel is skipped when unset —
# leads are still captured and logged, but nothing is delivered.
RESEND_API_KEY=
# Verified sender, e.g. hello@zacsol.com. onboarding@resend.dev only delivers
# to the Resend account owner — fine for testing, not for production.
RESEND_FROM_EMAIL=
# Reply-to on outbound mail, and the fallback destination for internal alerts
# RESEND_REPLY_TO=
# Where new-lead and new-booking alerts go. Falls back to RESEND_REPLY_TO.
# LEADS_NOTIFY_EMAIL=

# App URL (used for absolute links in emails / OG / sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Draft / Live Preview shared secret (Preview button in Payload admin)
# Generate any long random string, e.g. openssl rand -hex 24
PREVIEW_SECRET=

# Search Console / Bing verification (optional — paste token only)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Cloudflare Turnstile — bot protection on every public form.
# Both keys are required together; with either missing, verification is SKIPPED
# and a warning is logged once per process. Required before a public launch.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cron authorisation. Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
# Without it the cron routes REFUSE TO RUN in production — an open nurture
# endpoint is a way to mail the same person forty times.
#   openssl rand -hex 32
CRON_SECRET=

# --- Booking ---------------------------------------------------------------
# Set NEXT_PUBLIC_CAL_LINK to hand scheduling to Cal.com entirely (e.g.
# "zacsol/30min"). Leave it unset to use the built-in calendar below, which
# needs no third-party account.
# NEXT_PUBLIC_CAL_LINK=
#
# Office hours for the built-in calendar. Times are local to BOOKING_TIMEZONE;
# visitors always see them converted to their own zone.
# BOOKING_TIMEZONE=Asia/Karachi
# BOOKING_SLOTS=09:30,11:00,13:30,15:00,16:30
# BOOKING_WORKING_DAYS=1,2,3,4,5      # 1 = Monday … 7 = Sunday
# BOOKING_DURATION_MINUTES=30
# BOOKING_HORIZON_DAYS=28
# BOOKING_MIN_NOTICE_HOURS=12
# BOOKING_HOST_NAME=
# Standing video link sent with every invite (Meet / Zoom / Whereby)
# BOOKING_MEETING_URL=

# Add later when needed:
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# SENTRY_DSN=
