# Copy to .env.local (or .env) and fill in values.
# Never commit real secrets. Server-only keys must not use NEXT_PUBLIC_.

# Google AI Studio — Gemini (server-only)
GEMINI_API_KEY=
# Optional: override default model slugs
# GEMINI_PRO_MODEL=gemini-2.5-pro
# GEMINI_FLASH_MODEL=gemini-2.5-flash

# Payload CMS
PAYLOAD_SECRET=

# Neon Postgres
# Prefer sslmode=verify-full (or omit sslmode — we normalize require → verify-full in code)
DATABASE_URL=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend transactional email
RESEND_API_KEY=
# Optional: verified sender, e.g. hello@zacsol.com
RESEND_FROM_EMAIL=

# App URL (used for absolute links in emails / OG / sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Search Console / Bing verification (optional — paste token only)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Add later when needed:
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# SENTRY_DSN=
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# CAL_COM_URL=
